  "design_context": {
    "395:57078": {
      "structure": "div.track (auto-layout row, items-start, w=square/600/switch-width, p=square/600/padding, rounded=border-radius/full) > [ div.space (w=20, self-stretch) , div.◆/Handle ]",
      "handle": "div (size=square/600/icon=28, p=space/0,5=2, rounded 20) > div.Handle (absolute inset 2px, opacity/content/handle-opacity) = круг Ø24, fill check-radio/selected/handle",
      "note": "порядок детей задаёт положение: Selected → space ПЕРЕД бегунком (бегунок справа); Unselected → бегунок ПЕРЕД space (бегунок слева). Ширина space = 20 = switch-width − 2×padding − icon (отдельного токена нет)"
    },
    "395:57108": {
      "structure": "div.track > [ div.◆/Handle , div.space (w=20) ]",
      "note": "Unselected — бегунок слева"
    },
    "395:57138": {
      "structure": "handle > [ div.Handle (круг) , div.ic24-checkbox-outline (flex-1, h-full = 24×24) > Union (inset 29.17% / 20.83%, 14×10) ]",
      "note": "Var=Icon, Selected — галка внутри бегунка, fill = check-radio/selected/bg (цвет ТРЕКА, выбита в тёмном круге)"
    },
    "395:57168": {
      "structure": "handle > [ div.Handle (круг) , div.ic24-close-outline (flex-1, h-full = 24×24) > Union (inset 20.83%, 14×14) ]",
      "note": "Var=Icon, Unselected — крестик, fill = check-radio/unselected/bg"
    },
    "395:57201": {
      "structure": "div.track > div.FocusSelection (inset -1px) > div.outline (border 2px solid [focus-selection/outline], inset -1px, rounded=border-radius/full)",
      "note": "кольцо занимает полосу 0…2px СНАРУЖИ трека → CSS outline-offset: 0 (в отличие от .btn, где offset 2px)"
    }
  },
