  "relation_to_checkbox_radio": {
    "identical": ["палитра трека check-radio selected + unselected", "прогрессия состояний rest → hover → focus → active → disabled", "focus outline 2px surface-on-highest, offset 0", "disabled = opacity 40% на обёртке"],
    "different": ["горизонтальная геометрия: switch-width + едущий бегунок вместо квадрата/круга", "появился размер 600", "четвёртая ось Var (Default / Icon) — выражена наличием иконок в разметке", "handle-цвет (primary-on-dim / secondary-container-on) — своя роль, у checkbox/radio не используется", "иконка залита цветом трека, а не контрастной ролью"]
