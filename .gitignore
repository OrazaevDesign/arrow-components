# Собранный пакет живёт в отдельной ветке `dist`, а не в main: корень той ветки =
# корень пакета, и потребитель тянет только собранное. Локально dist/ появляется от
# прогона tools/build-dist.mjs — в main он не коммитится.
dist/

# Рабочие копии worktree, которые создаёт workflow при публикации ветки dist.
.dist/
